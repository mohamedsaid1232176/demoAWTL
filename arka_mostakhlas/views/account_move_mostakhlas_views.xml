<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="account_move_form_mostakhlas_tab" model="ir.ui.view">
        <field name="name">account.move.form.mostakhlas.tab</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/notebook" position="before">
                <field name="is_mostakhlas_invoice" invisible="1"/>
            </xpath>
            <xpath expr="//page[@name='invoice_tab']" position="after">
                <page string="Mostakhlas" name="mostakhlas_invoice_tab" invisible="not is_mostakhlas_invoice">
                    <group>
                        <group>
                            <field name="mostakhlas_number" readonly="1"/>
                            <field name="mostakhlas_date" readonly="1"/>
                            <field name="mostakhlas_type" readonly="1"/>
                        </group>
                        <group>
                            <field name="mostakhlas_sale_order_id" readonly="1"/>
                            <field name="mostakhlas_pdf_filename" invisible="1"/>
                        </group>
                    </group>

                    <group string="Mostakhlas PDF">
                        <field name="mostakhlas_pdf"
                               widget="pdf_viewer"
                               filename="mostakhlas_pdf_filename"
                               readonly="1"
                               nolabel="1"/>
                    </group>

                    <field name="mostakhlas_detail_line_ids" readonly="1">
                        <list>
                            <field name="sequence_int"/>
                            <field name="product_id"/>
                            <field name="name"/>
                            <field name="product_uom_id"/>
                            <field name="product_qty"/>
                            <field name="price_unit"/>
                            <field name="discount" optional="hide"/>
                            <field name="tax_ids" widget="many2many_tags" optional="show"/>
                            <field name="contract_total"/>
                            <field name="progress_percent"/>
                            <field name="executed_value"/>
                            <field name="notes" optional="hide"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
