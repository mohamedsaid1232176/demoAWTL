<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_mostakhlas_type_list" model="ir.ui.view">
        <field name="name">mostakhlas.type.list</field>
        <field name="model">mostakhlas.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="view_mostakhlas_type_form" model="ir.ui.view">
        <field name="name">mostakhlas.type.form</field>
        <field name="model">mostakhlas.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_mostakhlas_type" model="ir.actions.act_window">
        <field name="name">نوع المستخلص</field>
        <field name="res_model">mostakhlas.type</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- قائمة تحت Sales الرئيسية -->
    <menuitem id="menu_mostakhlas_root"
              name="المستخلصات"
              parent="sale.sale_menu_root"
              sequence="50"/>

    <menuitem id="menu_mostakhlas_type"
              name="نوع المستخلص"
              parent="menu_mostakhlas_root"
              action="action_mostakhlas_type"
              sequence="1"/>

</odoo>
