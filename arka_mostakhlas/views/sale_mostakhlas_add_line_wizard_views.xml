<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sale_mostakhlas_add_order_line_list" model="ir.ui.view">
        <field name="name">sale.mostakhlas.add.order.line.list</field>
        <field name="model">sale.order.line</field>
        <field name="arch" type="xml">
            <list string="Order Lines">
                <field name="order_id"/>
                <field name="product_id" string="Product"/>
                <field name="name" string="Description"/>
                <field name="product_uom_qty" string="Qty"/>
                <field name="qty_delivered" string="Delivery"/>
                <field name="product_uom" string="UoM"/>
                <field name="price_unit" string="Unit Price"/>
            </list>
        </field>
    </record>

    <record id="view_sale_mostakhlas_add_line_wizard_form" model="ir.ui.view">
        <field name="name">sale.mostakhlas.add.line.wizard.form</field>
        <field name="model">sale.mostakhlas.add.line.wizard</field>
        <field name="arch" type="xml">
            <form string="Add New Line">
                <group>
                    <field name="order_id" invisible="1"/>
                    <field name="sale_line_ids"
                           domain="[('order_id', '=', order_id), ('display_type', '=', False)]"
                           context="{'tree_view_ref': 'arka_mostakhlas.view_sale_mostakhlas_add_order_line_list'}"
                           options="{'no_create': True}">
                        <list>
                            <field name="sequence"/>
                            <field name="product_id"/>
                            <field name="name"/>
                            <field name="product_uom_qty"/>
                            <field name="qty_delivered"/>
                            <field name="product_uom"/>
                        </list>
                    </field>
                </group>
                <footer>
                    <button name="action_add_lines"
                            string="Add"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancel"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
