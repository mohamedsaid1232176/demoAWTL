<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="sale_order_form_mostakhlas" model="ir.ui.view">
        <field name="name">sale.order.form.mostakhlas</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <!-- ─── Header Buttons ───────────────────── -->
            <xpath expr="//header" position="inside">
                <button name="action_open_mostakhlas_tab"
                        string="Make Mostakhlas"
                        type="object"
                        class="btn-primary"
                       />
                <button name="action_open_sale_mostakhlas_wizard"
                        string="Print Mostakhlas"
                        type="object"
                        class="btn-secondary"
                        invisible="not show_mostakhlas_tab"/>
            </xpath>

            <!-- ─── Mostakhlas No. next to partner ───── -->
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="mostakhlas_sequence" string="Mostakhlas No." readonly="1"/>
            </xpath>

            <xpath expr="//div[@name='button_box']/button[@name='action_view_invoice']" position="after">
                <button name="action_view_mostakhlas_proforma_invoices"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-file-text-o">
                    <field name="mostakhlas_proforma_invoice_count"
                           widget="statinfo"
                           string="Proforma Invoices"/>
                </button>
            </xpath>

            <!-- ─── Tabs ─────────────────────────────── -->
            <xpath expr="//notebook" position="inside">

                <!-- ══ Mostakhlas Tab ════════════════════ -->
                <page string="Mostakhlas"
                      name="sale_mostakhlas_tab"
                      invisible="not show_mostakhlas_tab">

                    <button name="action_open_add_mostakhlas_line_wizard"
                            string="Add New Line"
                            type="object"
                            class="btn-secondary"/>

                    <field name="mostakhlas_line_ids">
                        <list editable="bottom">
                            <field name="sequence_int"      string="#"           readonly="1"/>
                            <field name="sale_line_id"      column_invisible="1"/>
                            <field name="product_id"        string="Product"     readonly="1"/>
                            <field name="name"              string="Description" readonly="1"/>
                            <field name="mostakhlas_type_id" string="Type"/>
                            <field name="product_qty"       string="Qty"         readonly="1"/>
                            <field name="delivery"          string="Delivery"    readonly="1"/>
                            <field name="product_uom"       string="UoM"         readonly="1"/>
                            <field name="price_unit"        string="Unit Price"  readonly="1"/>
                            <field name="discount"          string="Disc.%"      readonly="1" optional="hide"/>
                            <field name="taxes_id"          string="Taxes"       widget="many2many_tags"
                                                            readonly="1" optional="show"/>
                            <field name="price_subtotal"    string="Amount"      readonly="1"/>
                            <field name="progress_percent"  string="Current Progress %"
                                                            readonly="is_progress_locked"/>
                            <field name="done_progress"     string="Progress Done %"  readonly="1"/>
                            <field name="print_in_report"   string="Print"/>
                            <field name="is_progress_locked" column_invisible="1"/>
                        </list>
                    </field>

                    <group class="oe_subtotal_footer">
                        <field name="mostakhlas_untaxed"          string="Untaxed Amount"  readonly="1"/>
                        <field name="mostakhlas_tax"              string="VAT (15%)"       readonly="1"/>
                        <field name="mostakhlas_total"            string="Total"           readonly="1"/>
                        <separator/>
                        <field name="executed_contract_value"     readonly="1"/>
                        <field name="executed_contract_value_vat" readonly="1"/>
                    </group>
                </page>

                <!-- ══ Customer Payments Tab ═════════════ -->
                <page string="Customer Payments"
                      name="customer_payments_tab"
                      invisible="not show_mostakhlas_tab">

                    <field name="sale_payment_ids">
                        <list>
                            <field name="name"                       string="Payment Ref."/>
                            <field name="date"                       string="Date"/>
                            <field name="state"                      string="Status"/>
                            <field name="amount"                     string="Amount"/>
                            <field name="is_used_in_sale_mostakhlas" string="Used in Mostakhlas"
                                                                     readonly="1"/>
                        </list>
                    </field>

                    <group class="oe_subtotal_footer">
                        <field name="sale_payment_total_all" string="Total Collected" readonly="1"/>
                    </group>
                </page>

                <!-- ══ Important Data Tab ════════════════ -->
                <page string="Important Data"
                      name="sale_important_data"
                      invisible="not show_mostakhlas_tab">

                    <group string="Project Manager">
                        <field name="project_manager" string="Name"/>
                    </group>

                    <group string="Operations Manager">
                        <field name="operations_manager" string="Name"/>
                    </group>

                    <group string="Client">
                        <field name="client_name"  string="Name"/>
                        <field name="date_client"  string="Date"/>
                    </group>

                    <group string="Project">
                        <field name="project_id" string="Project"/>
                    </group>

                </page>

            </xpath>

        </field>
    </record>

</odoo>
