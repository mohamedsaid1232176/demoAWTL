<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_sale_mostakhlas_wizard_form" model="ir.ui.view">
        <field name="name">sale.mostakhlas.wizard.form</field>
        <field name="model">sale.mostakhlas.wizard</field>
        <field name="arch" type="xml">
            <form string="تأكيد طباعة مستخلص البيع">
                <group>
                    <field name="date_mostakhlas"/>
                </group>
                <footer>
                    <button name="action_confirm"
                            string="تأكيد وطباعة"
                            type="object"
                            class="btn-primary"/>
                    <button string="إلغاء" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_sale_mostakhlas_wizard" model="ir.actions.act_window">
        <field name="name">مستخلص البيع</field>
        <field name="res_model">sale.mostakhlas.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
