<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ========================== -->
    <!-- Tree View                  -->
    <!-- ========================== -->
    <record id="view_mostakhlas_type_tree" model="ir.ui.view">
        <field name="name">mostakhlas.type.tree</field>
        <field name="model">mostakhlas.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <!-- ========================== -->
    <!-- Form View                  -->
    <!-- ========================== -->
    <record id="view_mostakhlas_type_form" model="ir.ui.view">
        <field name="name">mostakhlas.type.form</field>
        <field name="model">mostakhlas.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ========================== -->
    <!-- Action                     -->
    <!-- ========================== -->
    <record id="action_mostakhlas_type" model="ir.actions.act_window">
        <field name="name">نوع المستخلص</field>
        <field name="res_model">mostakhlas.type</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ========================== -->
    <!-- Main Menu: المستخلص        -->
    <!-- ========================== -->

    <!-- Group يظهر فقط في شركة ARKA -->
    <record id="group_arka_company_only" model="res.groups">
        <field name="name">ARKA Only</field>
        <field name="category_id" ref="base.module_category_hidden"/>
    </record>

  <menuitem id="menu_mostakhlas_root"
          name="المستخلص"
          parent="purchase.menu_purchase_root"
          sequence="220"
          groups="arka_purchase_mostakhlas.group_arka_company_only"/>

<menuitem id="menu_mostakhlas_type"
          name="نوع المستخلص"
          parent="menu_mostakhlas_root"
          action="action_mostakhlas_type"
          groups="arka_purchase_mostakhlas.group_arka_company_only"
          sequence="1"/>


</odoo>
