<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_mostakhlas_wizard_form" model="ir.ui.view">
        <field name="name">mostakhlas.wizard.form</field>
        <field name="model">mostakhlas.wizard</field>
        <field name="arch" type="xml">
            <form string="تأكيد طباعة المستخلص">
                <group>
                    <field name="date_mostakhlas"/>
                </group>
                <footer>
                    <button name="action_confirm"
                            string="Confirm"
                            type="object"
                            class="oe_highlight"/>

                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_mostakhlas_wizard" model="ir.actions.act_window">
        <field name="name">Mostakhlas Wizard</field>
        <field name="res_model">mostakhlas.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
