<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="custom_report_invoice_document" inherit_id="account.report_invoice_document">

        <xpath expr="//div[@name='shipping_address_block']//div[@t-field='o.partner_shipping_id']" position="replace">
            <div>
                <strong t-esc="o.partner_shipping_id.contact_name or o.partner_shipping_id.name or ''"/>
                <br/>
                <div t-field="o.partner_shipping_id"
                     t-options='{"widget": "contact", "fields": ["address"], "no_marker": True, "delimiter": "&lt;br/&gt;"}'/>
            </div>
        </xpath>

        <xpath expr="//div[@name='address_not_same_as_shipping']//address" position="replace">
            <address class="mb-0">
                <strong t-esc="o.partner_id.contact_name or o.partner_id.name or ''"/>
                <br/>
                <div t-field="o.partner_id"
                     t-options='{"widget": "contact", "fields": ["address"], "no_marker": True, "delimiter": "&lt;br/&gt;"}'/>
            </address>
        </xpath>

        <xpath expr="//div[@name='address_same_as_shipping']//address" position="replace">
            <address class="mb-0">
                <strong t-esc="o.partner_id.contact_name or o.partner_id.name or ''"/>
                <br/>
                <div t-field="o.partner_id"
                     t-options='{"widget": "contact", "fields": ["address"], "no_marker": True, "delimiter": "&lt;br/&gt;"}'/>
            </address>
        </xpath>

        <xpath expr="//div[@name='no_shipping']//address" position="replace">
            <address class="mb-0">
                <strong t-esc="o.partner_id.contact_name or o.partner_id.name or ''"/>
                <br/>
                <div t-field="o.partner_id"
                     t-options='{"widget": "contact", "fields": ["address"], "no_marker": True, "delimiter": "&lt;br/&gt;"}'/>
            </address>
        </xpath>

    </template>

</odoo>