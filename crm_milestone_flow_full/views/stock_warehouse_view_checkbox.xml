<odoo>

    <record id="view_warehouse_form_inherit_project" model="ir.ui.view">
        <field name="name">stock.warehouse.form.project.checkbox</field>
        <field name="model">stock.warehouse</field>
        <field name="inherit_id" ref="stock.view_warehouse"/>
        <field name="arch" type="xml">

            <!-- نحط الـ checkbox في أول الفورم -->
            <xpath expr="//field[@name='code']" position="after">
                <field name="is_project_warehouse"/>
            </xpath>

        </field>
    </record>

</odoo>