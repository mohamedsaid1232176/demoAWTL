<odoo>
    <record id="view_replace_milestone_item_form" model="ir.ui.view">
        <field name="name">replace.milestone.item.form</field>
        <field name="model">wizard.replace.milestone.item</field>
        <field name="arch" type="xml">
            <form string="Replace Item">
                <group>
                    <field name="line_id" invisible="1"/>
                    <field name="milestone_id" invisible="1"/>
                    <field name="product_type" invisible="1"/>
                    <field name="old_product_id" readonly="1"/>
                    <field name="new_product_id"
                           domain="[('product_tmpl_id.milestone_ids','in',[milestone_id]), ('product_tmpl_id.type','=', product_type)]"/>
                    <field name="qty"/>
                    <field name="pricing_method"/>
                    <field name="pricelist_id" invisible="pricing_method != 'pricelist'"/>
                    <field name="pricelist_sale_price" invisible="pricing_method != 'pricelist'" readonly="1"/>
                    <field name="manual_product_cost" invisible="pricing_method != 'margin'"/>
                    <field name="margin" invisible="pricing_method != 'margin'"/>
                    <field name="unit_price"/>
                </group>
                <footer>
                    <button name="action_confirm_replace"
                            string="Confirm Replace"
                            type="object"
                            class="btn-primary"
                            confirm="Are you sure you want to replace the old item with the new item?"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
