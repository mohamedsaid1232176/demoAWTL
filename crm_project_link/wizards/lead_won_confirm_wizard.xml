<odoo>
    <record id="view_sale_order_project_wizard" model="ir.ui.view">
        <field name="name">sale.order.project.wizard.form</field>
        <field name="model">sale.order.project.wizard</field>
        <field name="arch" type="xml">
            <form string="Confirm Project Creation">

                   <group>
                    <div>
                        <p>
                            <strong>هل أنت متأكد أنك تريد تحويل الـ Lead إلى WON؟</strong>
                        </p>
                        <p>سيتم إنشاء مشروع جديد تلقائياً.</p>
                    </div>
                </group>

                <footer>
                    <button string="نعم" type="object" name="action_confirm_project" class="btn-primary"/>
                    <button string="إلغاء" special="cancel" class="btn-secondary"/>
                </footer>

            </form>
        </field>
    </record>
</odoo>