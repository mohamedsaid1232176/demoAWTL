<odoo>

    <record id="view_analytic_account_form_inherit_location" model="ir.ui.view">
        <field name="name">analytic.account.form.location</field>
        <field name="model">account.analytic.account</field>
        <field name="inherit_id" ref="analytic.view_account_analytic_account_form"/>
        <field name="arch" type="xml">

        <xpath expr="//field[@name='code']" position="after">
            <field name="unit_type" />
            <field name="building_id" invisible="unit_type not in ('apartment', 'room','bed') or not is_company_subscription"/>
            <field name="apartment_id" invisible="unit_type not in ('room','bed') or not is_company_subscription"/>
            <field name="room_id" invisible="unit_type != 'bed' or not is_company_subscription"/>
                
            </xpath>

            <xpath expr="//notebook" position="inside">

                <page string="شقق" name="apartments" invisible="unit_type != 'building' or not is_company_subscription">
                    <group>
                        <field name="apartment_ids" readonly="1">
                            <list editable="bottom">
                                <field name="name"/>
                            </list>
                        </field>
                    </group>

                </page>

                <page name="rooms" string="غرف" invisible="unit_type not in ('building', 'apartment') or not is_company_subscription">
                    <group>
                        <field name="room_ids" readonly="1">
                            <list editable="bottom">
                                <field name="name"/>
                            </list>
                        </field>
                    </group>

                </page>

                <page name="beds" string="سرير" invisible="unit_type not in ('building', 'apartment','room') or not is_company_subscription">

                    <group>
                        <field name="bed_ids" readonly="1">
                            <list editable="bottom">
                                <field name="name"/>
                            </list>
                        </field>
                    </group>
                </page>


            </xpath>

        </field>
    </record>

</odoo>