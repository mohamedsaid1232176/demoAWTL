<?xml version="1.0" encoding="utf-8"?>
<odoo>

<record id="view_contract_type_list" model="ir.ui.view">
    <field name="name">contract.type.list</field>
    <field name="model">contract.type</field>
    <field name="arch" type="xml">
        <list string="Contract Types">
            <field name="name"/>
        </list>
    </field>
</record>

<record id="view_contract_type_form" model="ir.ui.view">
    <field name="name">contract.type.form</field>
    <field name="model">contract.type</field>
    <field name="arch" type="xml">
        <form string="Contract Type">
            <sheet>
                <group>
                    <field name="name"/>
                </group>
            </sheet>
        </form>
    </field>
</record>

<record id="action_contract_type" model="ir.actions.act_window">
    <field name="name">Contract Types</field>
    <field name="res_model">contract.type</field>
    <field name="view_mode">list,form</field>
    <field name="help" type="html">
        <p class="o_view_nocontent_smiling_face">
            Define different contract types for your subscriptions.
        </p>
    </field>
</record>

<menuitem id="menu_contract_type"
 name="Contract Types"
 parent="sale_subscription.menu_sale_subscription"
 action="action_contract_type"/>

    

</odoo>
