<?xml version="1.0" encoding="utf-8"?>
<odoo>

<record id="view_organization_type_list" model="ir.ui.view">
    <field name="name">organization.type.list</field>
    <field name="model">organization.type</field>
    <field name="arch" type="xml">
        <list string="Organization Types">
            <field name="name"/>
        </list>
    </field>
</record>

<record id="view_organization_type_form" model="ir.ui.view">
    <field name="name">organization.type.form</field>
    <field name="model">organization.type</field>
    <field name="arch" type="xml">
        <form string="Organization Type">
            <sheet>
                <group>
                    <field name="name"/>
                </group>
            </sheet>
        </form>
    </field>
</record>

<record id="action_organization_type" model="ir.actions.act_window">
    <field name="name">Organization Types</field>
    <field name="res_model">organization.type</field>
    <field name="view_mode">list,form</field>
    <field name="help" type="html">
        <p class="o_view_nocontent_smiling_face">
            Define different organization types for your subscriptions.
        </p>
    </field>
</record>

<menuitem id="menu_organization_type"
 name="Organization Types"
 parent="sale_subscription.menu_sale_subscription"
 action="action_organization_type"/>

    

</odoo>
