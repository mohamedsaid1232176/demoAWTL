<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_product_template_form_inherit_location" model="ir.ui.view">
        <field name="name">product.template.form.location</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='categ_id']" position="after">
            <field name="is_company_subscription" invisible="1"/>
                        </xpath>

            <xpath expr="//notebook" position="inside">

                <page string="Location" name="location" invisible="not is_company_subscription">

                    <group>
                        <group>
                            <field name="subscription_product" invisible="1"/>
                            <field name="analytic_account_id"/>
                            <field name="unit_type" widget="radio" required="is_company_subscription"/>
                            <field name="building_id" invisible="unit_type not in ('room','apartment','bed')"/>
                            <field name="apartment_id" invisible="unit_type not in ('room','bed')"/>
                            <field name="room_id" invisible="unit_type != 'bed'"/>
                        </group>

                        <group>
                            <button name="action_link_analytic"
                                type="object"
                                string="Link Analytic Account"
                                class="btn-primary"
                                invisible="not is_company_subscription"/>
                        </group>
                    </group>

                </page>

                <page name="building_description" string="وصف العقار"  invisible="unit_type != 'building'">

                    <group string="وصف العقار">

                        <group>
                            <field name="national_address"/>
                            <field name="location_description"/>
                            <field name="property_usage"/>
                            <field name="property_type"/>
                        </group>

                        <group>
                            <field name="floor_no"/>
                            <field name="elevators_no"/>
                            <field name="units_no"/>
                            <field name="parking_lots"/>
                        </group>

                    </group>

                </page>

            </xpath>

        </field>
    </record>

</odoo>