<?xml version="1.0" encoding="utf-8"?>
<odoo>

<record id="view_property_type_list" model="ir.ui.view">
    <field name="name">property.type.list</field>
    <field name="model">property.type</field>
    <field name="arch" type="xml">
        <list string="Property Types">
            <field name="name"/>
        </list>
    </field>
</record>

<record id="view_property_type_form" model="ir.ui.view">
    <field name="name">property.type.form</field>
    <field name="model">property.type</field>
    <field name="arch" type="xml">
        <form string="Property Type">
            <sheet>
                <group>
                    <field name="name"/>
                </group>
            </sheet>
        </form>
    </field>
</record>

<record id="action_property_type" model="ir.actions.act_window">
    <field name="name">Property Types</field>
    <field name="res_model">property.type</field>
    <field name="view_mode">list,form</field>
    <field name="help" type="html">
        <p class="o_view_nocontent_smiling_face">
            Define different property types for your subscriptions.
        </p>
    </field>
</record>

<menuitem id="menu_property_type"
    name="Property Types"
    parent="sale_subscription.menu_sale_subscription"
    action="action_property_type"/>

    

</odoo>
