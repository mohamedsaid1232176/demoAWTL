<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_subscription" model="ir.ui.view">
        <field name="name">res.company.form.subscription</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='currency_id']" position="after">
                <field name="organization_type"/>
            </xpath>

            <xpath expr="//notebook" position="inside">
                <page string="Subscription" name="subscription">
                    <group>
                        <field name="is_subscription"/>
                        <field name="subscription_product" invisible="not is_subscription"/>
                        <field name="subscription_state_ids" widget="many2many_tags" invisible="not subscription_product"/>
                    </group>
                </page>
            </xpath>

        </field>
    </record>
</odoo>