<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <record id="view_res_partner_form_inherit_nationality" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.nationality</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">

            <xpath expr="//page[@name='internal_notes']" position="after">

                <page name="tenancy_info" string="بيانات المستأجر">
                    <group>
                        <field name="tenancy_nationality"/>
                        <field name="tenancy_id_type_id"/>
                        <field name="tenancy_id"/>
                    </group>
                </page>

            </xpath>

        </field>
    </record>
</odoo>
