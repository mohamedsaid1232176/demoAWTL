<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Tree View -->
    <record id="view_subscription_state_list" model="ir.ui.view">
        <field name="name">subscription.state.list</field>
        <field name="model">subscription.state</field>
        <field name="arch" type="xml">
            <list string="Subscription States">
                <field name="name"/>
                <field name="value"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_subscription_state_form" model="ir.ui.view">
        <field name="name">subscription.state.form</field>
        <field name="model">subscription.state</field>
        <field name="arch" type="xml">
            <form string="Subscription State">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="value"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_subscription_state" model="ir.actions.act_window">
        <field name="name">Subscription States</field>
        <field name="res_model">subscription.state</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menu -->
    <menuitem 
        id="menu_subscription_state"
        name="Subscription States"
        parent="sale.menu_sale_config"
        action="action_subscription_state"
        sequence="10"
    />

</odoo>