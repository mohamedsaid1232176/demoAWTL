<?xml version="1.0" encoding="utf-8"?>
<odoo>

<record id="view_title_deed_type_list" model="ir.ui.view">
    <field name="name">title.deed.type.list</field>
    <field name="model">title.deed.type</field>
    <field name="arch" type="xml">
        <list string="Title Deed Types">
            <field name="name"/>
        </list>
    </field>
</record>

<record id="view_title_deed_type_form" model="ir.ui.view">
    <field name="name">title.deed.type.form</field>
    <field name="model">title.deed.type</field>
    <field name="arch" type="xml">
        <form string="Title Deed Type">
            <sheet>
                <group>
                    <field name="name"/>
                </group>
            </sheet>
        </form>
    </field>
</record>

<record id="action_title_deed_type" model="ir.actions.act_window">
    <field name="name">Title Deed Types</field>
    <field name="res_model">title.deed.type</field>
    <field name="view_mode">list,form</field>
    <field name="help" type="html">
        <p class="o_view_nocontent_smiling_face">
            Define different Title Deed types for your subscriptions.
        </p>
    </field>
</record>

<menuitem id="menu_title_deed_type"
 name="Title Types"
 parent="sale_subscription.menu_sale_subscription"
 action="action_title_deed_type"/>

    

</odoo>
