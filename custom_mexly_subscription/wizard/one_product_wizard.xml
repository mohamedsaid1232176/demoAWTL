<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_one_product_wizard_form" model="ir.ui.view">
        <field name="name">one.product.wizard.form</field>
        <field name="model">one.product.wizard</field>
        <field name="arch" type="xml">
            <form string="One Product Wizard">
                <group>
                    <field name="product_id"/>
                    <field name="quantity"/>
                    <field name="unit_price"/>
                </group>
                <footer>
                    <button string="Confirm" type="object" name="action_confirm" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_one_product_wizard" model="ir.actions.act_window">
        <field name="name">One Product Wizard</field>
        <field name="res_model">one.product.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>