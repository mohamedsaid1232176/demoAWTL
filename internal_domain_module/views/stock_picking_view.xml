<odoo>
    <data>

        <record id="picking_internal_fields" model="ir.ui.view">
            <field name="name">stock.picking.internal.fields</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="stock.view_picking_form"/>

            <field name="arch" type="xml">

                <!-- Hide ORIGINAL Source when internal -->
                <xpath expr="//field[@name='location_id' and @groups='stock.group_stock_multi_locations']"
                       position="attributes">
                    <attribute name="invisible">is_internal_transfer</attribute>
                </xpath>

                <!-- Hide ORIGINAL Destination when internal -->
                <xpath expr="//field[@name='location_dest_id' and @groups='stock.group_stock_multi_locations']"
                       position="attributes">
                    <attribute name="invisible">is_internal_transfer</attribute>
                </xpath>

                <!-- Show NEW Internal Source Only when internal -->
                <xpath expr="//field[@name='location_id' and @groups='stock.group_stock_multi_locations']"
                       position="after">
                    <field name="internal_source_id"
                           domain="[('usage', '=', 'internal')]"
                           invisible="not is_internal_transfer"/>

                </xpath>

                <!-- Show NEW Internal Destination Only when internal -->
                <xpath expr="//field[@name='location_dest_id' and @groups='stock.group_stock_multi_locations']"
                       position="after">
                    <field name="internal_dest_id"
                           domain="[
           '|',
           ('usage', '=', 'transit'),
           '&amp;',
           ('usage', '=', 'internal'),
           ('name', 'ilike', 'Consignment')
       ]"
                           invisible="not is_internal_transfer"/>

                </xpath>

            </field>
        </record>

    </data>
</odoo>
