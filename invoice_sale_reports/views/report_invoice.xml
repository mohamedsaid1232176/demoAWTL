<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="invoice_internal_layout_w_header">
        <t t-if="not o" t-set="o" t-value="doc"/>
            <div class="header" style="width:100%; font-family:Arial, Helvetica, sans-serif; margin-bottom:20px;">
    
            <table style="width:100%; border-collapse:collapse; border:none; margin-bottom:20px; font-family:Arial, Helvetica, sans-serif;border:1px solid white;">

                <tr>

                    <td style="width:60%; vertical-align:top; text-align:left; border:none;">

                        <div style="margin-bottom:10px;">
                            <img t-if="o.company_id.logo"
                                t-att-src="image_data_uri(o.company_id.logo)"
                                style="max-height:90px; max-width:180px; object-fit:contain;"/>
                        </div>

                        <div style="font-size:11pt; line-height:1.6;">

                            <div style="font-weight:bold;color:#0A1F44;">
                                شركة بلس بلد المحدودة
                            </div>

                            <div>
                                الرياض، المصيف، RIYADH، 12465، 6071
                            </div>

                            <div>
                                المملكة العربية السعودية
                            </div>

                            <div>
                                info@plusgroup.sa.com
                            </div>

                            <div>
                                رقم التسجيل الضريبي: 1010689416
                            </div>

                            <div>
                                رقم السجل التجاري: 1010248766
                            </div>

                        </div>
                    </td>

                    <td style="width:40%; text-align:right; vertical-align:top; direction:rtl; border:none;">

                        <div style="font-size:26pt; font-weight:bold; color:#0A1F44;">
                            فاتورة ضريبية
                        </div>
                    
                        <div style="font-size:30pt; font-weight:900; margin-top:8px; color:#0A1F44;">
                            Tax Invoice
                        </div>
                    
                    </td>
                </tr>
            </table>

            </div>

            <div class="article" t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id" t-att-data-oe-lang="o and o.env.context.get('lang')">
              <t t-out="0"/>
            </div>

            <div t-attf-class="footer o_standard_footer"  style="margin-top:40px; width:100%;font-size:10px; font-family: Arial, Helvetica, sans-serif; page-break-inside: avoid; padding-top:20px; padding-bottom:20px;">
                <div style="clear: both; margin-top: 100px; text-align: center; font-size: 10pt;">
                    شركة بلس بلد المحدودة
            </div>

            </div>

        </template>

    <template id="custom_tax_invoice_report" inherit_id="l10n_sa.arabic_english_invoice">

        <xpath expr="//t[@t-call='web.external_layout']" position="replace">
            <t t-call="web.html_container">
            <t t-call="invoice_sale_reports.invoice_internal_layout_w_header">

            <div class="page" style="font-family: Arial, 'Helvetica Neue', Helvetica, sans-serif; font-size: 11pt; 
                                     direction: ltr; 
                                     padding: 20px 40px 40px 40px; 
                                     min-height: 100%;">

                <div style="display: table; width: 100%; margin-bottom: 25px;">

                <div style="display: table-row;">

                    <div style="display: table-cell; width:45%; vertical-align: top; text-align:left;">

                        <t t-if="o.l10n_sa_qr_code_str and o._l10n_sa_is_legal()">
                            <img t-att-src="'/report/barcode/?barcode_type=QR&amp;value=%s&amp;width=200&amp;height=200' % o.l10n_sa_qr_code_str"
                                style="max-width:120px;"/>
                        </t>

                    </div>

                    <div style="display: table-cell; width:55%; vertical-align: top; font-size:11pt;">

                        <table style="width:100%; border-collapse:collapse; border:none; margin-bottom:20px; font-family:Arial, Helvetica, sans-serif;border:1px solid white;">


                            <tr style="height:28px;">
                                <td style="text-align:left;">
                                    Invoice No. :
                                </td>
                                <td style="text-align:center; font-weight:bold;">
                                    <span t-field="o.name"/>
                                </td>
                                <td style="text-align:right; direction:rtl; font-weight:bold;">
                                    رقم الفاتورة:
                                </td>
                            </tr>

                            <tr style="height:28px;">
                                <td style="text-align:left;">
                                    Date :
                                </td>
                                <td style="text-align:center;">
                                    <span t-field="o.invoice_date" t-options='{"format": "dd-MM-yyyy"}'/>
                                </td>
                                <td style="text-align:right; direction:rtl; font-weight:bold;">
                                    التاريخ:
                                </td>
                            </tr>

                            <tr style="height:28px;">
                                <td style="text-align:left;">
                                    Due Date :
                                </td>
                                <td style="text-align:center;">
                                    <span t-field="o.invoice_date_due" t-options='{"format": "dd-MM-yyyy"}'/>
                                </td>
                                <td style="text-align:right; direction:rtl; font-weight:bold;">
                                    تاريخ الاستحقاق:
                                </td>
                            </tr>

                            <tr style="height:28px;">

                                <td style="text-align:left;">
                                    <t t-if="o.move_type in ['in_invoice', 'in_refund']">
                                        Vendor :
                                    </t>
                                    <t t-else="">
                                        Customer :
                                    </t>
                                </td>

                                <td style="text-align:center;">
                                    <span t-field="o.partner_id.name"
                                        style="font-weight: bold; font-size: 12pt;"/>
                                </td>

                                <td style="text-align:right; direction:rtl; font-weight:bold;">
                                    <t t-if="o.move_type in ['in_invoice', 'in_refund']">
                                        المورد:
                                    </t>
                                    <t t-else="">
                                        العميل:
                                    </t>
                                </td>

                            </tr>

                        </table>

                    </div>

                </div>
                </div>

                <table name="invoice_line_table" class="table table-bordered" style="width: 100%; border-collapse: collapse; font-size: 10pt; margin-bottom: 30px;">
                    <thead>
                        <tr style="background-color: #f5f5f5; text-align: center; font-weight: bold;">
                            <th style="border: 1px solid #000; padding: 8px; width: 11%;">القيمة المضافة<br/>VAT amount</th>
                            <th style="border: 1px solid #000; padding: 8px; width: 13%;">المبلغ الخاضع<br/>Taxable amount</th>
                            <th style="border: 1px solid #000; padding: 8px; width: 13%;">المجموع<br/>Line amount</th>
                            <th style="border: 1px solid #000; padding: 8px; width: 12%;">السعر<br/>Price</th>
                            <th style="border: 1px solid #000; padding: 8px; width: 7%;">الكمية<br/>Qty</th>
                            <th style="border: 1px solid #000; padding: 8px; text-align: right;">الوصف / Description</th>
                            <th style="border: 1px solid #000; padding: 8px; width: 4%;">#</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="o.invoice_line_ids" t-as="line">
                            <tr>
                                <td style="border: 1px solid #000; padding: 8px; text-align: right;">
                                    <span t-esc="', '.join(line.tax_ids.mapped('name'))"/> 
                                </td>
                                <td style="border: 1px solid #000; padding: 8px; text-align: right;">
                                    <span t-esc="line.price_total" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                </td>
                                <td style="border: 1px solid #000; padding: 8px; text-align: right; font-weight: bold;">
                                    <span t-esc="line.price_subtotal" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                </td>
                                <td style="border: 1px solid #000; padding: 8px; text-align: right;">
                                    <span t-field="line.price_unit" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                </td>
                                <td style="border: 1px solid #000; padding: 8px; text-align: center;">
                                    <span t-field="line.quantity" t-options='{"widget": "float", "decimal_places": 0}'/>
                                </td>
                                <td style="border: 1px solid #000; padding: 8px; text-align: right;">
                                    <span t-field="line.name"/>
                                </td>
                                <td style="border: 1px solid #000; padding: 8px; text-align: center;">
                                    <span t-esc="line_index + 1"/>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </table>

                <div style="width:100%; margin-top:20px; display:flex; justify-content:flex-end;">

                    <table style="width:50%; border-collapse:collapse; border:none; margin-bottom:20px; font-family:Arial, Helvetica, sans-serif;border:1px solid white;">


                        <tr>
                            <td style="text-align:left; padding:6px;">
                                <span t-field="o.amount_untaxed"
                                    t-options='{"widget": "monetary", "display_currency": o.currency_id}'
                                    style="font-weight:bold;"/>
                            </td>
                            <td style="text-align:right; direction:rtl; padding:6px;">
                                Subtotal / المجموع الفرعي
                            </td>
                        </tr>

                        <tr>
                            <td style="text-align:left; padding:6px;">
                                <span t-field="o.amount_tax"
                                    t-options='{"widget": "monetary", "display_currency": o.currency_id}'
                                    style="font-weight:bold;"/>
                            </td>
                            <td style="text-align:right; direction:rtl; padding:6px;">
                                Total VAT / إجمالي ضريبة القيمة المضافة
                            </td>
                        </tr>

                        <tr style="border-top:2px solid #000;">
                            <td style="text-align:left; padding:8px;">
                                <span t-field="o.amount_total"
                                    t-options='{"widget": "monetary", "display_currency": o.currency_id}'
                                    style="font-size:16pt; font-weight:bold;"/>
                            </td>
                            <td style="text-align:right; direction:rtl; padding:8px; font-weight:bold;">
                                Total / المجموع شامل الضريبة
                            </td>
                        </tr>

                    </table>

                </div>
                <div id="total"></div>

              

            </div>
            </t>
            </t>
        </xpath>

    </template>

</odoo>
