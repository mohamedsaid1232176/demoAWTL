<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_dark_saleorder_full_page" model="report.paperformat">
        <field name="name">Dark Sale Order Full Page</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">0</field>
        <field name="margin_bottom">0</field>
        <field name="margin_left">0</field>
        <field name="margin_right">0</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="disable_shrinking" eval="True"/>
        <field name="dpi">96</field>
    </record>

    <record id="sale.action_report_saleorder" model="ir.actions.report">
        <field name="paperformat_id" ref="invoice_sale_reports.paperformat_dark_saleorder_full_page"/>
    </record>

    <template id="sale_order_layout_w_header">
        <div style="width:232mm; margin:0 0 0 -10mm; padding:0; box-sizing:border-box; font-family:Arial, 'DejaVu Sans', sans-serif; color:#ffffff; background-color:#000000;">
            <div style="width:210mm; margin-left:10mm; padding:46px 54px 22px 54px; box-sizing:border-box;">
            <div style="display:table; width:100%;">
                <div style="display:table-row;">
                    <div style="display:table-cell; width:50%; vertical-align:top;">
                        <div style="display:table; width:160px; margin-top:0;">
                            <div style="display:table-row;">
                                <div style="display:table-cell; width:46px; vertical-align:middle;">
                                    <span style="display:block; width:12px; height:34px; margin-left:28px; background-color:#3aa4e6;"></span>
                                    <span style="display:block; width:38px; height:9px; margin-top:-12px; background-color:#4b3a91;"></span>
                                    <span style="display:block; width:12px; height:34px; margin-left:20px; margin-top:4px; background-color:#3cc17d;"></span>
                                </div>
                                <div style="display:table-cell; vertical-align:middle; padding-left:10px;">
                                    <div dir="rtl" style="font-size:27pt; line-height:0.82; font-weight:700; color:#ffffff;">بلس</div>
                                    <div style="font-size:25pt; line-height:0.92; font-weight:700; color:#ffffff;">Plus</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div style="display:table-cell; width:50%; vertical-align:top; text-align:left; padding-top:20px;">
                        <div style="font-size:22pt; font-weight:700; line-height:1.05; margin-bottom:22px;">
                            <span>quotation</span>
                            <span dir="rtl">عرض مالي</span>
                        </div>
                        <div style="font-size:11pt; line-height:1.48; color:#efefef;">
                            <span>6071, king abdulaziz road, elmasif, riyadh,</span><br/>
                            <span>12465, Kingdom of Saudi Arabia</span><br/>
                            <span>info@plusgroup.sa.com</span><br/>
                            <span>VAT number 311369497000003</span><br/>
                            <span>CR Number 1010248766</span>
                        </div>
                    </div>
                </div>
            </div>

            <div style="width:100%; margin-top:42px; font-size:10.5pt; color:#ffffff;">
                <div style="display:table; width:100%; border-bottom:1px solid #ffffff;">
                    <div style="display:table-cell; width:12%; padding:2px 0 5px 0;">Customer</div>
                    <div style="display:table-cell; width:76%; padding:2px 8px 5px 8px; text-align:center;">
                        <span t-field="o.partner_id.name"/>
                    </div>
                    <div dir="rtl" style="display:table-cell; width:12%; padding:2px 0 5px 0; text-align:right;">العميل</div>
                </div>
                <div style="display:table; width:100%; border-bottom:1px solid #ffffff;">
                    <div style="display:table-cell; width:12%; padding:2px 0 5px 0;">Address</div>
                    <div style="display:table-cell; width:76%; padding:2px 8px 5px 8px; text-align:center;">
                        <span t-field="o.partner_id.contact_address"/>
                    </div>
                    <div dir="rtl" style="display:table-cell; width:12%; padding:2px 0 5px 0; text-align:right;">العنوان</div>
                </div>
                <div style="display:table; width:100%;">
                    <div style="display:table-cell; width:47%; border-bottom:1px solid #ffffff;">
                        <div style="display:table; width:100%;">
                            <div style="display:table-cell; width:25%; padding:2px 0 5px 0;">Phone</div>
                            <div style="display:table-cell; width:50%; padding:2px 8px 5px 8px; text-align:center;">
                                <span t-esc="o.partner_id.mobile or o.partner_id.phone"/>
                            </div>
                            <div dir="rtl" style="display:table-cell; width:25%; padding:2px 8px 5px 8px; text-align:right;">الهاتف</div>
                        </div>
                    </div>
                    <div style="display:table-cell; width:6%;"></div>
                    <div style="display:table-cell; width:47%; border-bottom:1px solid #ffffff;">
                        <div style="display:table; width:100%;">
                            <div style="display:table-cell; width:31%; padding:2px 8px 5px 8px;">VAT<br/>Number</div>
                            <div style="display:table-cell; width:39%; padding:2px 8px 5px 8px; text-align:center;">
                                <span t-esc="o.partner_id.vat"/>
                            </div>
                            <div dir="rtl" style="display:table-cell; width:30%; padding:2px 0 5px 0; text-align:right;">رقم التسجيل<br/>الضريبي</div>
                        </div>
                    </div>
                </div>
                <div style="display:table; width:100%;">
                    <div style="display:table-cell; width:47%; border-bottom:1px solid #ffffff;">
                        <div style="display:table; width:100%;">
                            <div style="display:table-cell; width:25%; padding:2px 0 5px 0;">Quote<br/>Number</div>
                            <div style="display:table-cell; width:50%; padding:2px 8px 5px 8px; text-align:center;">
                                <span t-field="o.name"/>
                            </div>
                            <div dir="rtl" style="display:table-cell; width:25%; padding:2px 8px 5px 8px; text-align:right;">رقم عرض<br/>السعر</div>
                        </div>
                    </div>
                    <div style="display:table-cell; width:6%;"></div>
                    <div style="display:table-cell; width:47%; border-bottom:1px solid #ffffff;">
                        <div style="display:table; width:100%;">
                            <div style="display:table-cell; width:31%; padding:2px 8px 5px 8px;">Date</div>
                            <div style="display:table-cell; width:39%; padding:2px 8px 5px 8px; text-align:center;">
                                <span t-field="o.date_order" t-options='{"widget": "date"}'/>
                            </div>
                            <div dir="rtl" style="display:table-cell; width:30%; padding:2px 0 5px 0; text-align:right;">التاريخ</div>
                        </div>
                    </div>
                </div>
                <div style="display:table; width:100%;">
                    <div style="display:table-cell; width:47%; border-bottom:1px solid #ffffff;">
                        <div style="display:table; width:100%;">
                            <div style="display:table-cell; width:25%; padding:2px 0 5px 0;">Referance</div>
                            <div style="display:table-cell; width:50%; padding:2px 8px 5px 8px; text-align:center;">
                                <span t-field="o.client_order_ref"/>
                            </div>
                            <div dir="rtl" style="display:table-cell; width:25%; padding:2px 8px 5px 8px; text-align:right;">تم بواسطة</div>
                        </div>
                    </div>
                    <div style="display:table-cell; width:6%;"></div>
                    <div style="display:table-cell; width:47%; border-bottom:1px solid #ffffff;">
                        <div style="display:table; width:100%;">
                            <div style="display:table-cell; width:31%; padding:2px 8px 5px 8px;">Project</div>
                            <div style="display:table-cell; width:39%; padding:2px 8px 5px 8px; text-align:center;">
                                <span t-field="o.project_id"/>
                            </div>
                            <div dir="rtl" style="display:table-cell; width:30%; padding:2px 0 5px 0; text-align:right;">المشروع</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        </div>
    </template>

    <template id="sale_order_internal_layout_w_header">
        <t t-if="not o" t-set="o" t-value="doc"/>
        <div class="article" t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id" t-att-data-oe-lang="o and o.env.context.get('lang')">
            <t t-out="0"/>
        </div>
    </template>

    <template id="report_saleorder_document_custom"
              inherit_id="sale.report_saleorder_document"
              priority="100">

        <xpath expr="//t[@t-call='web.external_layout']" position="replace">

            <t t-call="web.html_container">
                <style>
                    @page {
                        margin: 0mm !important;
                        size: A4 portrait;
                    }
                    * {
                        box-sizing: border-box !important;
                    }
                    html, body {
                        margin: 0 !important;
                        padding: 0 !important;
                        background: #1b1c1c !important;
                        -webkit-print-color-adjust: exact !important;
                        print-color-adjust: exact !important;
                        color-adjust: exact !important;
                    }
                    main, #wrapwrap, .o_report_layout, .o_report_layout_standard, .article {
                        margin: 0 !important;
                        padding: 0 !important;
                        background: #1b1c1c !important;
                        -webkit-print-color-adjust: exact !important;
                        print-color-adjust: exact !important;
                    }
                    .container, .container-fluid, .row {
                        width: 100% !important;
                        max-width: 100% !important;
                        margin: 0 !important;
                        padding: 0 !important;
                    }
                    .page {
                        margin: 0 !important;
                        padding: 0 !important;
                        page-break-after: avoid !important;
                        page-break-inside: avoid !important;
                    }
                    .footer, .header {
                        display: none !important;
                    }
                    table.dark-lines, table.dark-lines tr, table.dark-lines th, table.dark-lines td {
                        border-left: 0 !important;
                        border-right: 0 !important;
                        border-top: 0 !important;
                    }
                </style>

                <t t-foreach="docs" t-as="doc">
                    <t t-set="o" t-value="doc"/>
                    <t t-call="invoice_sale_reports.sale_order_internal_layout_w_header">

                    <div class="page" style="width:232mm; height:297mm; margin:0 0 0 -10mm; padding:0; box-sizing:border-box; position:relative; overflow:hidden; font-family:Arial, 'DejaVu Sans', sans-serif; font-size:9pt; line-height:1.25; color:#ffffff; background-color:#1b1c1c;">
                        <div style="position:absolute; top:-8mm; left:0; right:0; bottom:0; background-color:#1b1c1c; z-index:0;"></div>
                        <div style="position:relative; z-index:1; width:210mm; height:100%; margin-left:10mm;">

                        <t t-call="invoice_sale_reports.sale_order_layout_w_header"/>

                        <div style="padding:28px 54px 0 54px; box-sizing:border-box; width:100%;">

                        <table class="dark-lines" style="width:100%; border-collapse:separate; border-spacing:0; color:#ffffff; font-size:10pt; margin-bottom:26px;">
                            <thead>
                                <tr>
                                    <th style="width:12%; padding:0 8px 13px 8px; border:0 !important; border-bottom:1.4px solid #ffffff !important; text-align:center; font-weight:700;">
                                        <span dir="rtl">المجموع</span><br/>Line Amount
                                    </th>
                                    <th style="width:13%; padding:0 8px 13px 8px; border:0 !important; border-bottom:1.4px solid #ffffff !important; text-align:center; font-weight:700;">
                                        <span dir="rtl">القيمة المضافة</span><br/>VAT Amount
                                    </th>
                                    <th style="width:17%; padding:0 8px 13px 8px; border:0 !important; border-bottom:1.4px solid #ffffff !important; text-align:center; font-weight:700;">
                                        <span dir="rtl">المبلغ الخاضع للضريبة</span><br/>Taxable Amount
                                    </th>
                                    <th style="width:11%; padding:0 8px 13px 8px; border:0 !important; border-bottom:1.4px solid #ffffff !important; text-align:center; font-weight:700;">
                                        <span dir="rtl">السعر</span><br/>Price
                                    </th>
                                    <th style="width:10%; padding:0 8px 13px 8px; border:0 !important; border-bottom:1.4px solid #ffffff !important; text-align:center; font-weight:700;">
                                        <span dir="rtl">الكمية</span><br/>QTY
                                    </th>
                                    <th style="padding:0 8px 13px 8px; border:0 !important; border-bottom:1.4px solid #ffffff !important; text-align:right; font-weight:700;">
                                        <span dir="rtl">الوصف</span><br/>Description
                                    </th>
                                    <th style="width:4%; padding:0 0 13px 8px; border:0 !important; border-bottom:1.4px solid #ffffff !important; text-align:right; font-weight:700;">#</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="doc.order_line" t-as="line">
                                    <tr>
                                        <td style="height:35px; padding:5px 8px; border:0 !important; border-bottom:1px solid #666666 !important; text-align:center;">
                                            <span t-field="line.price_total" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                        </td>
                                        <td style="height:35px; padding:5px 8px; border:0 !important; border-bottom:1px solid #666666 !important; text-align:center;">
                                            <span t-esc="line.price_tax" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                        </td>
                                        <td style="height:35px; padding:5px 8px; border:0 !important; border-bottom:1px solid #666666 !important; text-align:center;">
                                            <span t-field="line.price_subtotal" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                        </td>
                                        <td style="height:35px; padding:5px 8px; border:0 !important; border-bottom:1px solid #666666 !important; text-align:center;">
                                            <span t-field="line.price_unit" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                        </td>
                                        <td style="height:35px; padding:5px 8px; border:0 !important; border-bottom:1px solid #666666 !important; text-align:center;">
                                            <span t-esc="line.product_uom_qty"/>
                                        </td>
                                        <td dir="rtl" style="height:35px; padding:5px 8px; border:0 !important; border-bottom:1px solid #666666 !important; text-align:right;">
                                            <span t-field="line.name"/>
                                        </td>
                                        <td style="height:35px; padding:5px 0 5px 8px; border:0 !important; border-bottom:1px solid #666666 !important; text-align:right;">
                                            <span t-esc="line_index + 1"/>
                                        </td>
                                    </tr>
                                </t>

                                <t t-set="blank_rows" t-value="max(0, 3 - len(doc.order_line))"/>
                                <t t-foreach="range(blank_rows)" t-as="blank">
                                    <tr>
                                        <td colspan="7" style="height:35px; border:0 !important; border-bottom:1px solid #666666 !important;"></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <div style="display:table; width:100%; margin-top:4px;">
                            <div style="display:table-row;">
                                <div style="display:table-cell; width:50%; vertical-align:top;">
                                    <table style="width:100%; border-collapse:separate; border-spacing:0; color:#ffffff; font-size:10pt;">
                                        <tr>
                                            <td style="width:28%; padding:12px 8px; border:0 !important; border-bottom:1px solid #666666 !important; text-align:center; font-weight:700;">
                                                <span t-field="doc.amount_untaxed" t-options='{"widget":"monetary","display_currency":doc.currency_id}'/>
                                            </td>
                                            <td style="padding:12px 8px; border:0 !important; border-bottom:1px solid #666666 !important; text-align:center; font-weight:700;">
                                                Subtotal <span dir="rtl">المجموع الفرعي</span>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td style="padding:12px 8px; border:0 !important; border-bottom:1px solid #666666 !important; text-align:center; font-weight:700;">
                                                <span t-field="doc.amount_tax" t-options='{"widget":"monetary","display_currency":doc.currency_id}'/>
                                            </td>
                                            <td style="padding:12px 8px; border:0 !important; border-bottom:1px solid #666666 !important; text-align:center; font-weight:700;">
                                                Total VAT <span dir="rtl">إجمالي ضريبة القيمة المضافة</span>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td style="padding:12px 8px; border:0 !important; border-bottom:1px solid #666666 !important; text-align:center; font-weight:700;">
                                                <span t-field="doc.amount_total" t-options='{"widget":"monetary","display_currency":doc.currency_id}'/>
                                            </td>
                                            <td style="padding:12px 8px; border:0 !important; border-bottom:1px solid #666666 !important; text-align:center; font-weight:700;">
                                                Total VAT <span dir="rtl">المجموع شامل القيمة المضافة</span>
                                            </td>
                                        </tr>
                                    </table>
                                </div>

                                <div style="display:table-cell; width:50%; vertical-align:top; text-align:right; padding-top:118px; font-size:11pt; font-weight:700;">
                                    <span dir="rtl">الوصف</span><br/>Description
                                    <div t-if="doc.note" dir="rtl" style="margin-top:12px; font-size:8.5pt; line-height:1.45; font-weight:400; color:#eeeeee;">
                                        <span t-field="doc.note"/>
                                    </div>
                                </div>
                            </div>
                        </div>

                        </div>

                        <div style="position:absolute; left:54px; right:54px; bottom:22px; display:table; width:calc(100% - 108px); font-family:Arial, 'DejaVu Sans', sans-serif; font-size:7.5pt; color:#d8d8d8;">
                            <div style="display:table-row;">
                                <div style="display:table-cell; width:33%; text-align:left;">Page 1 of 1</div>
                                <div style="display:table-cell; width:34%; text-align:center;">
                                    <span t-field="doc.name"/>
                                </div>
                                <div style="display:table-cell; width:33%; text-align:right;">plusgroup.sa.com</div>
                            </div>
                        </div>
                        </div>
                    </div>
                    </t>
                </t>

            </t>

        </xpath>

    </template>

</odoo>
