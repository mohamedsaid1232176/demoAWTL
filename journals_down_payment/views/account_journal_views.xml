<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_account_journal_form_inherit_down_payment" model="ir.ui.view">
        <field name="name">account.journal.form.inherit.down.payment</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='code']" position="after">
                <field name="down_payment"/>
            </xpath>
        </field>
    </record>

    <record id="view_invoice_form_inherit_downpayment" model="ir.ui.view">
        <field name="name">account.move.form.add.downpayment</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_add_from_catalog']" position="after">
                <button name="action_view_downpayments" type="object" string="Add Down Payment" class="btn-link"/>
            </xpath>
        </field>
    </record>


    <record id="view_customer_downpayment_wizard_form" model="ir.ui.view">
        <field name="name">customer.downpayment.wizard.form</field>
        <field name="model">customer.downpayment.wizard</field>
        <field name="arch" type="xml">
            <form string="Select Down Payments">
                <group>
                    <field name="partner_id"/>
                    <field name="invoice_id"/>
                    <field name="downpayment_ids" widget="many2many_tags"/>
                </group>
                <footer>
                    <button name="action_add_to_invoice" string="Add" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>



    <!-- Action -->
    <record id="action_customer_downpayment_invoices" model="ir.actions.act_window">
        <field name="name">Customer Down Payments</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('move_type','=','out_invoice'),('journal_id.down_payment','=',True)]</field>
        <field name="context">{'default_move_type': 'out_invoice'}</field>
    </record>

    <menuitem id="menu_customer_downpayment_invoices"
              name="Down Payment Invoices"
              parent="account.menu_account_customer"
              action="action_customer_downpayment_invoices"
              sequence="0"/>



    <!-- views/account_payment_views.xml -->
    <record id="view_account_payment_form_inherit_downpayment" model="ir.ui.view">
        <field name="name">account.payment.form.inherit.downpayment</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_bank_id']" position="after">
                <field name="down_payment" string="Down payment"/>
            </xpath>
        </field>
    </record>

</odoo>