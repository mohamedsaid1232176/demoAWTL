<odoo>

    <record id="view_project_form_inherit_code" model="ir.ui.view">
        <field name="name">project.project.form.inherit.code</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">

            <!-- نحط الكود تحت اسم المشروع مباشرة -->
            <xpath expr="//field[@name='label_tasks']" position="before">
                <field name="code" readonly="1" class="ms-3"/>
            </xpath>

        </field>
    </record>

</odoo>
