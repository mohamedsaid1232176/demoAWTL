<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ========================================================= -->
    <!-- ACTIONS (Added context to hide buttons) -->
    <!-- ========================================================= -->

    <record id="action_project_management_proposition" model="ir.actions.act_window">
        <field name="name">مشروعات مرحلة</field>
        <field name="res_model">crm.lead</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('stage_id.name', '=', 'Technical Office')]</field>
        <field name="context">{'active_model': 'not_crm', 'hide_crm_buttons': True,'in_projects_management': True}
        </field>
    </record>

    <record id="action_project_management_projects" model="ir.actions.act_window">
        <field name="name">Projects Management</field>
        <field name="res_model">crm.lead</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('stage_id.name', '=', 'Projects Management')]</field>
        <field name="context">{'active_model': 'not_crm', 'hide_crm_buttons': True,'in_projects_management': True}
        </field>
    </record>

    <record id="action_project_management_product_variants_clean" model="ir.actions.act_window">
        <field name="name">Product Variants</field>
        <field name="res_model">product.product</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_project_management_milestone_quotation" model="ir.actions.act_window">
        <field name="name">Milestone Quotations</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('opportunity_id.is_milestone_quotation_generated', '=', True)]</field>
        <field name="context">{'active_model': 'not_crm', 'hide_crm_buttons': True,'in_projects_management': True}
        </field>
    </record>

    <record id="action_project_management_designer" model="ir.actions.act_window">
        <field name="name">Designer Pipeline</field>
        <field name="res_model">crm.lead</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('stage_id.name', '=', 'Designer')]</field>
        <field name="context">{'active_model': 'not_crm', 'hide_crm_buttons': True,'in_projects_management': True}
        </field>
    </record>
    <!-- ========================================================= -->
    <!-- MENUS -->
    <!-- ========================================================= -->

    <menuitem id="menu_project_management_root" name="Projects Management" sequence="1"/>

    <menuitem id="menu_project_management_designer"
              name="Designer"
              parent="menu_project_management_root"
              action="action_project_management_designer"
              sequence="1"/>

    <menuitem id="menu_project_management_proposition"
              name="Technical Office"
              parent="menu_project_management_root"
              action="action_project_management_proposition"
              sequence="2"/>

    <menuitem id="menu_project_management_projects"
              name="Project Management"
              parent="menu_project_management_root"
              action="action_project_management_projects"
              sequence="3"/>

    <menuitem id="menu_project_management_milestone_quotations"
              name="Quotation from Milestones"
              parent="menu_project_management_root"
              action="action_project_management_milestone_quotation"
              sequence="4"/>

    <menuitem id="menu_project_management_configuration"
              name="Configuration"
              parent="menu_project_management_root"
              sequence="100"/>

    <menuitem id="menu_project_management_products"
              name="Products"
              parent="menu_project_management_configuration"
              action="product.product_template_action"
              sequence="10"/>

    <menuitem id="menu_project_management_product_variants"
              name="Product Variants"
              parent="menu_project_management_configuration"
              action="action_project_management_product_variants_clean"
              sequence="20"
              groups="product.group_product_variant"/>

    <!-- ========================================================= -->
    <!-- HIDE CRM BUTTONS IN form VIEW -->
    <!-- ========================================================= -->

    <!-- Hide WON button -->
    <record id="hide_won_button_pm" model="ir.ui.view">
        <field name="name">crm.lead.hide.won.pm</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//form[@class='o_lead_opportunity_form']//header//button[@name='action_set_won_rainbowman']"
                   position="attributes">
                <attribute name="invisible">hide_all_buttons_pm</attribute>
            </xpath>

        </field>
    </record>


    <!-- Hide LOST button -->
    <record id="hide_lost_button_pm" model="ir.ui.view">
        <field name="name">crm.lead.hide.lost.pm</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//form[@class='o_lead_opportunity_form']//header//button[@name='404']"
                   position="attributes">
                <attribute name="invisible">hide_all_buttons_pm</attribute>
            </xpath>

        </field>
    </record>


</odoo>