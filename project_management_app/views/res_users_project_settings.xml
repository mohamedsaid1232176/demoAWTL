<odoo>
    <record id="view_users_form_inherit_project_management_access" model="ir.ui.view">
        <field name="name">res.users.form.project.management.access</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="crm_proposition_button.view_users_form_inherit_project_button"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='show_project_button']/ancestor::page[1]" position="inside">
                <group string="Application Access" col="2">
                    <group>
                        <field name="show_project_management_app"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
