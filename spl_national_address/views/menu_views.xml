<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_spl_national_address_partners" model="ir.actions.act_window">
        <field name="name">National Addresses</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'default_is_company': True}</field>
    </record>

    <record id="action_spl_national_address_settings" model="ir.actions.act_window">
        <field name="name">SPL National Address Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module': 'spl_national_address'}</field>
    </record>

    <menuitem
        id="menu_spl_national_address_root"
        name="SPL National Address"
        sequence="75"/>

    <menuitem
        id="menu_spl_national_address_partners"
        name="Addresses"
        parent="menu_spl_national_address_root"
        action="action_spl_national_address_partners"
        sequence="10"/>

    <menuitem
        id="menu_spl_national_address_settings"
        name="Settings"
        parent="menu_spl_national_address_root"
        action="action_spl_national_address_settings"
        groups="base.group_system"
        sequence="90"/>
</odoo>
