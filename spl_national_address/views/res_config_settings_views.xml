<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_spl_national_address" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.spl.national.address</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="SPL National Address" name="spl_national_address">
                    <block title="API Settings">
                        <setting string="API Key" help="Subscription key from the National Address APIs developer portal.">
                            <field name="spl_national_address_api_key" password="True"/>
                        </setting>
                        <setting string="Base URL">
                            <field name="spl_national_address_base_url"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
