<odoo>
    <record id="view_request_spare_parts_wizard_form" model="ir.ui.view">
        <field name="name">request.spare.parts.wizard.form</field>
        <field name="model">request.spare.parts.wizard</field>
        <field name="arch" type="xml">
            <form string="Request Spare Parts Confirmation">
                <sheet>

                    <!-- ===== Title ===== -->
                    <div class="oe_title">
                        <h2>
                            <i class="fa fa-cogs text-primary me-1"/>
                            Confirm Spare Parts Request
                        </h2>
                        <p class="text-muted">
                            Review the spare parts below. You can adjust the requested quantities before confirming.
                        </p>
                    </div>

                    <!-- ===== Info Message ===== -->
                    <div class="alert alert-info" role="alert">
                        <i class="fa fa-info-circle me-1"/>
                        You may edit the quantities. An internal transfer will be created after confirmation.
                    </div>

                    <!-- ===== Spare Parts List ===== -->
                    <group string="Spare Parts Details">
                        <field name="line_ids">
                            <list
                                    editable="bottom"
                                    create="0"
                                    delete="0"
                            >
                                <field name="product_id" readonly="1"/>
                                <field name="quantity"/>
                            </list>
                        </field>

                    </group>

                    <!-- ===== Footer ===== -->
                    <footer>
                        <button name="action_confirm"
                                type="object"
                                string="Confirm Request"
                                class="btn-primary"
                                icon="fa-check"/>

                        <button string="Cancel"
                                class="btn-secondary"
                                special="cancel"/>
                    </footer>

                </sheet>
            </form>
        </field>
    </record>
</odoo>
