<odoo>

    <record id="action_technician" model="ir.actions.act_window">
        <field name="name">Technicians</field>
        <field name="res_model">technician.technician</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_technician_list" model="ir.ui.view">
        <field name="name">technician.list</field>
        <field name="model">technician.technician</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="employee_id"/>
            </list>
        </field>
    </record>

    <record id="view_technician_form" model="ir.ui.view">
        <field name="name">technician.form</field>
        <field name="model">technician.technician</field>
        <field name="arch" type="xml">
            <form string="Technician">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Technician Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <menuitem id="menu_technician"
              name="Technicians"
              parent="sale.sale_order_menu"
              action="action_technician"
              sequence="50"/>

</odoo>
