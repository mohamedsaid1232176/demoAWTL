<odoo>
        <!-- Search View -->
    <record id="view_finger_template_search" model="ir.ui.view">
        <field name="name">finger.template.search</field>
        <field name="model">finger.template</field>
        <field name="arch" type="xml">
            <search string="Search Finger Templates">
                <field name="employee_id"/>
                <field name="device_id"/>
                <field name="device_user_id"/>
                <group expand="0" string="Group By">
                    <!-- Group By Filters with Default Context -->
                     <filter string="Device" name="device_fingerprint" context="{'group_by': 'device_id'}"/>
                    <filter string="Device User" name="device_fingerprint" context="{'group_by': 'device_user_id'}"/>
                </group>
            </search>

        </field>
    </record>


    <!-- List (Tree) View -->
    <record id="view_finger_template_tree" model="ir.ui.view">
        <field name="name">finger.template.list</field>
        <field name="model">finger.template</field>
        <field name="arch" type="xml">
            <list string="Finger Templates" create="0">
                <field name="employee_id"/>
                <field name="device_id"/>
                <field name="device_user_id"/>
                <field name="template_data" widget="binary"/>
                <field name="f_id"/>
                <field name="f_size"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_finger_template_form" model="ir.ui.view">
        <field name="name">finger.template.form</field>
        <field name="model">finger.template</field>
        <field name="arch" type="xml">
            <form string="Finger Template">
                <group>
                    <field name="employee_id"/>
                    <field name="device_id"/>
                    <field name="device_user_id"/>
                    <field name="template_data" widget="binary"/>
                    <field name="f_id"/>
                    <field name="f_size"/>
                </group>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_finger_template" model="ir.actions.act_window">
        <field name="name">Finger Templates</field>
        <field name="res_model">finger.template</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_finger_template_search"/>
        <field name="context">{'search_default_device_fingerprint': 1}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Create your first finger template
            </p>
        </field>
    </record>

    <!-- Menu Item -->
    <menuitem id="menu_finger_templates" name="Finger Templates"
              parent="tis_hr_biometric_attendance.menu_biometric_device_config"
              action="action_finger_template" sequence="40"/>
</odoo>
