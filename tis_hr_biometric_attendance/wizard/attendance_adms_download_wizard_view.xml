<odoo>
    <record id="view_attendance_adms_download_wizard_form" model="ir.ui.view">
        <field name="name">attendance.adms.download.wizard.form</field>
        <field name="model">attendance.adms.download.wizard</field>
        <field name="arch" type="xml">
            <form string="Download ADMS Attendance">
                <group>
                    <field name="device_id" invisible="1"/>
                    <field name="start_date"/>
                    <field name="end_date"/>
                </group>
                <footer>
                    <button name="action_submit" type="object" string="Download" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_attendance_adms_download_wizard" model="ir.actions.act_window">
        <field name="name">Confirm ADMS</field>
        <field name="res_model">attendance.adms.download.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
