<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_restart_button_wizard" model="ir.ui.view">
        <field name="name">view.restart.button.wizard</field>
        <field name="model">restart.button.wizard</field>
        <field name="arch" type="xml">
            <form string="Attendance Restart">
                <group>
                    <field name="warning_msg" readonly="1" nolabel="1"/>
                </group>
                <footer>
                    <button name="confirm_restart"
                            type="object"
                            string="Restart"
                            class="btn-danger"
                            />

                    <button string="Cancel"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
