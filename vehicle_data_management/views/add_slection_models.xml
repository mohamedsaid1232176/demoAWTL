<odoo>

    <!-- DEVICE TYPE VIEWS -->
    <record id="view_device_type_tree" model="ir.ui.view">
        <field name="name">device.type.tree</field>
        <field name="model">device.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="view_device_type_form" model="ir.ui.view">
        <field name="name">device.type.form</field>
        <field name="model">device.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_device_type" model="ir.actions.act_window">
        <field name="name">Device Types</field>
        <field name="res_model">device.type</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- =========================== -->
    <!--       MENU STRUCTURE        -->
    <!-- =========================== -->

    <!-- Sub menu: Configuration -->
    <menuitem id="menu_equipment_config"
              name="Configuration"
              parent="menu_vehicle_root"
              sequence="15"/>

    <!-- Device Types as a submenu under Configuration -->
    <menuitem id="menu_device_type"
              parent="menu_equipment_config"
              name="Device Types"
              action="action_device_type"
              sequence="20"/>


