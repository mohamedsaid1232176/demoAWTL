<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template
            id="report_payment_receipt_document_replace_all"
            inherit_id="account.report_payment_receipt_document">

        <!-- Replace the whole page content -->
        <xpath expr="//div[@class='page']" position="replace">


            <div class="page" style="text-align:center;">

                <!-- ===================== TITLE ===================== -->
                <h3 style="text-align:center; margin-bottom:20px;">
                    <strong>
                        Payment Request:
                        <span t-field="o.custom_sequence">INV0001</span>
                    </strong>
                </h3>

                <!-- ===================== PAYMENT REQUEST HEADER ===================== -->
                <table style="width:100%;
                                  border:1px solid #000;
                                  border-collapse:collapse;
                                  margin-bottom:20px;
                                  font-size:12px;
                                  margin-bottom:40px;
                    ">


                    <tbody>

                        <tr>
                            <td style="border:1px solid #000; width:25%; font-weight:bold; background:#f2f2f2;">
                                Requester Name
                            </td>
                            <td style="border:1px solid #000; width:25%;">
                                <span t-esc="o.report_employee_name"/>
                            </td>

                            <td style="border:1px solid #000; width:25%; font-weight:bold; background:#f2f2f2;">
                                Department
                            </td>
                            <td style="border:1px solid #000; width:25%;">
                                <span t-esc="o.report_department_name"/>
                            </td>
                        </tr>

                        <tr>
                            <td style="border:1px solid #000; font-weight:bold; background:#f2f2f2;">
                                Date
                            </td>
                            <td style="border:1px solid #000;">
                                <span t-field="o.date"/>
                            </td>

                            <td style="border:1px solid #000; font-weight:bold; background:#f2f2f2;">
                                Company
                            </td>
                            <td style="border:1px solid #000;">
                                <span t-esc="o.company_id.name"/>
                            </td>
                        </tr>

                    </tbody>
                </table>

                <!-- ===================== KIND OF PAYMENT / PURPOSE ===================== -->
                <table style="width:100%;
      border:1px solid #000;
      border-collapse:collapse;
      font-size:12px;
      margin-bottom:40px;">

    <thead>
        <tr>
            <th colspan="4"
                style="border-bottom:1px solid #000;
                       text-align:center;
                       font-weight:bold;
                       background:#e6e6e6;
                       padding:6px;">
                KIND OF PAYMENT / PURPOSE
            </th>
        </tr>
    </thead>

    <tbody>

        <t t-foreach="[o] + list(o.child_payment_ids)" t-as="p">

            <!-- Payment label -->
            <!-- <tr>
                <td colspan="4"
                    style="border-bottom:1px solid #000;
                           font-weight:bold;
                           background:#f9f9f9;
                           padding:6px;">
                    Payment: <t t-esc="p.custom_sequence or p.name"/>
                </td>
            </tr> -->

            <t t-set="kinds" t-value="p.kind_of_payment_id"/>
            <t t-set="rows"
               t-value="[kinds[i:i+4] for i in range(0, len(kinds), 4)]"/>

            <t t-foreach="rows" t-as="row">
                <tr style="border-bottom:1px solid #000;">
                    <t t-foreach="row" t-as="kind">
                        <td style="padding:6px; width:25%;">
                            ☑ <t t-esc="kind.name"/>
                        </td>
                    </t>
                    <t t-foreach="range(4 - len(row))" t-as="i">
                        <td></td>
                    </t>
                </tr>
            </t>

        </t>

    </tbody>
</table>



                <!-- ===================== PAYMENT DETAILS ===================== -->
                <table style="width:100%;
              border:1px solid #000;
              border-collapse:collapse;
              font-size:12px;
               margin-bottom:40px;">

                    <!-- Title -->
                    <thead>
                        <tr>
                            <th colspan="6"
                                style="border:1px solid #000;
                                    text-align:center;
                                    font-weight:bold;
                                    background:#e6e6e6;
                                    padding:6px;">
                                Payment Details
                            </th>

                        </tr>
                        <tr>
                            <th style="border:1px solid #000; width:10%; background:#f2f2f2;">
                                S. No.
                            </th>
                             <th style="border:1px solid #000; width:15%; background:#f2f2f2;">
                                Beneficiary
                            </th>
                            <th style="border:1px solid #000; width:40%; background:#f2f2f2;">
                                Description
                            </th>
                            <th style="border:1px solid #000; width:15%; background:#f2f2f2;">
                                Value
                            </th>
                            <th style="border:1px solid #000; width:15%; background:#f2f2f2;">
                                Project
                            </th>
                            <th style="border:1px solid #000; width:20%; background:#f2f2f2;">
                                Kind of Payment
                            </th>
                        </tr>
                    </thead>

                    <tbody>

                        <!-- 1️⃣ counter -->
                        <t t-set="sno" t-value="1"/>

                        <!-- 2️⃣ Iterate Payments -->
                        <t t-foreach="[o] + list(o.child_payment_ids)" t-as="p">

                            <tr>
                                <!-- S.No -->
                                <td style="border:1px solid #000; text-align:center;">
                                    <t t-esc="sno"/>
                                </td>

                                 <!-- Beneficiary -->
                                <td style="border:1px solid #000;">
                                    <t t-esc="p.partner_id.name or ''"/>
                                </td>

                                <!-- Description -->
                                <td style="border:1px solid #000;">
                                    <t t-esc="p.memo or ''"/>
                                </td>

                               
                                <!-- Value -->
                                <td style="border:1px solid #000; text-align:center;">
                                    <span t-field="p.amount"
                                          t-options="{'widget':'monetary','display_currency':p.currency_id}"/>
                                </td>

                                <!-- Project -->
                                <td style="border:1px solid #000;">
                                    <t t-esc="p.project_id.name or ''"/>
                                </td>

                                <!-- Kind of Payment -->
                                <td style="border:1px solid #000;">
                                    <t t-esc="p.kind_of_payment_id.name or ''"/>
                                </td>
                            </tr>

                            <!-- 3️⃣ increment counter -->
                            <t t-set="sno" t-value="sno + 1"/>

                        </t>

                        <!-- 4️⃣ Total -->
                        <tr>
                            <!-- S. No. -->
                            <td style="border:1px solid #000;"></td>

                            <!-- Beneficiary -->
                            <td style="border:1px solid #000;"></td>

                            <!-- Description -->
                            <td style="border:1px solid #000; font-weight:bold; text-align:center; background:#e6e6e6;">
                                TOTAL
                            </td>

                            <!-- ✅ Value column -->
                            <td style="border:1px solid #000; text-align:center; font-weight:bold; background:#e6e6e6;">
                                <span t-esc="sum(p.amount for p in ([o] + list(o.child_payment_ids)))"/>
                                <t t-esc="o.currency_id.name"/>
                            </td>

                            <!-- Project -->
                            <td style="border:1px solid #000;"></td>

                            <!-- Kind of Payment -->
                            <td style="border:1px solid #000;"></td>
                        </tr>


                    </tbody>

                    <table style="width:100%;
                        border:1px solid #000;
                        border-collapse:collapse;
                        font-size:12px;
                        margin-top:40px;">

                        <thead>
                            <tr>
                                <th colspan="6"
                                    style="border:1px solid #000;
                                        text-align:center;
                                        font-weight:bold;
                                        background:#e6e6e6;
                                        padding:6px;">
                                    (For Finance Department Use Only)
                                </th>
                            </tr>

                            <tr>
                                <th style="border:1px solid #000; background:#f2f2f2;">
                                    Official Name / Card
                                </th>
                                <th colspan="3" style="border:1px solid #000; background:#f2f2f2;">
                                    IBAN / Cheque
                                </th>
                                <th colspan="2" style="border:1px solid #000; background:#f2f2f2;">
                                    Bank Name
                                </th>
                            </tr>
                        </thead>

                        <tbody>

                            <t t-foreach="[o] + list(o.child_payment_ids)" t-as="p">

                                <tr>
                                    <!-- Official Name -->
                                    <td style="border:1px solid #000; padding:6px;">
                                        <t t-esc="p.partner_id.name or ''"/>
                                    </td>

                                    <!-- IBAN -->
                                    <td colspan="3" style="border:1px solid #000; padding:6px;">
                                        <t t-esc="p.partner_bank_id.sudo().acc_number or ''"/>
                                    </td>

                                    <!-- Bank Name -->
                                    <td colspan="2" style="border:1px solid #000; padding:6px;">
                                        <t t-esc="p.partner_bank_id.sudo().bank_id.name or ''"/>
                                    </td>
                                </tr>

                            </t>

                        </tbody>
                    </table>

                    <!-- ================================================================ -->


                    <!-- ===================== SIGNATURES ===================== -->
                    <table style="width:100%;
              border:1px solid #000;
              border-collapse:collapse;
              font-size:12px;
              margin-top:25px;
              text-align:center;">

                        <thead>
                            <tr>
                                <th style="border:1px solid #000; background:#e6e6e6; padding:8px;">
                                    Requester<br/>Signature
                                </th>
                                <th style="border:1px solid #000; background:#e6e6e6; padding:8px;">
                                    Purchase Manager
                                </th>
                                <th style="border:1px solid #000; background:#e6e6e6; padding:8px;">
                                    Accounting Approval
                                </th>
                                <th style="border:1px solid #000; background:#e6e6e6; padding:8px;">
                                    C.E.O<br/>Approval
                                </th>
                            </tr>
                        </thead>

                        <tbody>
                            <tr style="height:70px;">
                                <td style="border:1px solid #000;"><t t-if="o.requester_user_id">
                                    <strong t-esc="o.requester_user_id.name"/><br/>
                                </t></td>
                                <td style="border:1px solid #000;"><t t-if="o.manager_user_id">
                                    <strong t-esc="o.manager_user_id.name"/><br/>
                                </t></td>
                                <td style="border:1px solid #000;"><t t-if="o.accounting_user_id">
                                    <strong t-esc="o.accounting_user_id.name"/><br/>
                                </t></td>
                                <td style="border:1px solid #000;"><t t-if="o.ceo_user_id">
                                    <strong t-esc="o.ceo_user_id.name"/><br/>
                                </t></td>
                            </tr>
                        </tbody>

                    </table>
                    <!-- ================================================================ -->


                    <!-- ===================== FINANCE DEPARTMENT USE ONLY ===================== -->

                </table>
                <!-- ====================================================== -->

            </div>

        </xpath>

    </template>

</odoo>
