<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hr_expense_sheet_form_kind_of_payment" model="ir.ui.view">
        <field name="name">hr.expense.sheet.form.kind.of.payment</field>
        <field name="model">hr.expense.sheet</field>
        <field name="inherit_id" ref="hr_expense.view_hr_expense_sheet_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='state'][@widget='statusbar'][@statusbar_visible]" position="attributes">
                <attribute name="statusbar_visible">draft,requested,submit,approve,post,ceo,done</attribute>
            </xpath>

            <xpath expr="//header/button[@name='action_submit_sheet']" position="attributes">
                <attribute name="string">Request Approval</attribute>
                <attribute name="groups">vendor_payment_employee.group_request_payment</attribute>
            </xpath>
            <xpath expr="//header/button[@name='action_approve_expense_sheets']" position="attributes">
                <attribute name="string">Manager Approve</attribute>
                <attribute name="groups">vendor_payment_employee.group_payment_manager</attribute>
            </xpath>

            <xpath expr="//header/button[@name='action_sheet_move_post']" position="attributes">
                <attribute name="string">Accounting Approve</attribute>
                <attribute name="groups">vendor_payment_employee.group_payment_accounting</attribute>
            </xpath>

            <xpath expr="//header/button[@name='action_register_payment']" position="attributes">
                <!-- <attribute name="groups">vendor_payment_employee.group_confirm_payment</attribute> -->
                <attribute name="invisible">state != 'ceo'</attribute>
            </xpath>


          
             <xpath expr="//button[@name='action_register_payment']" position="before">
                <button name="action_ceo_approve_expense_sheets" string="CEO Approve" type="object" class="oe_highlight" invisible="state != 'post'"
                groups="vendor_payment_employee.group_payment_ceo"/>
            </xpath>

            <!-- Kind of Payment بعد Expense Report Date -->
            <xpath expr="//field[@name='accounting_date']" position="after">
                <field name="kind_of_payment_id"/>
                    <field name="project_id"/>

            </xpath>


            <xpath expr="//field[@name='name']" position="after">
                <div style="
                    font-size: 28px;
                    font-weight: 700;
                    margin-bottom: 10px;
                "
                   >

                    <field name="custom_sequence"
                           nolabel="1"
                           readonly="1"
                           style="
                               border: none;
                               background: transparent;
                               padding-left: 0;
                           "/>

                </div>
            </xpath>


        </field>
    </record>




    <record id="seq_hr_expense_prex" model="ir.sequence">
        <field name="name">Expense Sheet PREX</field>
        <field name="code">hr.expense.prex</field>
        <field name="prefix">PREX/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>


</odoo>
