<odoo>

    <record id="view_account_payment_form_inherit_child" model="ir.ui.view">
        <field name="name">account.payment.form.child.payment</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_bank_id']" position="after">
                <field name="parent_payment_id" invisible= " not is_child_payment" />
                
            </xpath>

            <!-- نضيف تاب جديد -->
            <xpath expr="//notebook" position="inside">
                <page string="Related Payments" invisible= "is_child_payment">
                    <field name="is_child_payment" invisible="True"/>
                    <field name="child_payment_ids"
                           context="{
                                'default_parent_payment_id': id,
                                'default_employee_id': employee_id,
                                'default_department_id': department_id,
                                'default_custom_sequence': custom_sequence,
                                'default_company_id': company_id,
                                'default_request_state': request_state,
                                'default_payment_type': payment_type,
                                'default_payment_method_line_id': payment_method_line_id,
                                'default_partner_bank_id': partner_bank_id,
                                'default_memo': memo,
                                'default_is_child_payment': True
                            }">
                            <!-- 'default_partner_id': partner_id, -->
                            <!-- 'default_journal_id': journal_id, -->
                            <!-- 'default_project_id': project_id, -->




                        <list create="true" edit="true" delete="true">
                            <field name="memo" string="Description"/>
                            <field name="amount"/>
                            <field name="kind_of_payment_id"/>
                            <field name="project_id"/>
                        </list>
                    </field>

                </page>
            </xpath>

        </field>
    </record>


</odoo>