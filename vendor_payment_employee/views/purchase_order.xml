<odoo>
    <record id="view_purchase_order_form_inherit_approval" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.approval</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">

            <xpath expr="//header" position="after">
                <div style="text-align:center; margin-top:10px;">
                <field name="purchase_state"
                    widget="statusbar"
                    invisible="not show_workflow"
                    statusbar_visible="draft,procurement_officer,purchase_manager,ceo_confirmed"
                    options="{'clickable': False}"/>
                </div>
            </xpath>

            <xpath expr="//button[@name='button_confirm'][@id='draft_confirm']" position="attributes">
                <attribute name="invisible">show_workflow or state != 'draft'</attribute>
            </xpath>

            <xpath expr="//button[@name='button_confirm'][@id='bid_confirm']" position="attributes">
                <attribute name="invisible">show_workflow or state != 'sent'</attribute>
            </xpath>

            <xpath expr="//header" position="inside">
      
                <button name="action_submit_request"
                        string="Procurement Purchase Officer"
                        type="object"
                        class="btn-primary"
                        groups="vendor_payment_employee.group_procurement_officer"
                        invisible="not show_workflow or state != 'draft' or purchase_state != 'draft' "/>

                <button name="action_review"
                        string="Purchase Manager"
                        type="object"
                        class="btn-primary"
                        groups="vendor_payment_employee.group_purchase_manager"
                        invisible="not show_workflow or purchase_state != 'procurement_officer'"/>

                <button name="action_ceo_confirm"
                        string="CO Confirm"
                        type="object"
                        class="btn-primary"
                        groups="vendor_payment_employee.group_purchase_ceo"
                        invisible="not show_workflow or purchase_state != 'purchase_manager'"/>
            </xpath>

        </field>
    </record>
</odoo>