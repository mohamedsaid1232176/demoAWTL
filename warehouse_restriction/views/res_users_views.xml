<odoo>
    <record id="view_users_form_inherit_warehouse" model="ir.ui.view">
        <field name="name">res.users.form.warehouse.restriction</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">

            <!-- الأفضل والمضمون -->
            <xpath expr="//page[@name='access_rights']" position="inside">
                <group string="Warehouse Access">
                    <field name="allowed_warehouse_ids" widget="many2many_tags"/>
                </group>
            </xpath>

        </field>
    </record>







</odoo>
