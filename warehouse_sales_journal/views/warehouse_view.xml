<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- =====================================================
         Warehouse Form - Sales Journal
    ====================================================== -->
    <record id="view_warehouse_form_inherit_sales_journal" model="ir.ui.view">
        <field name="name">stock.warehouse.form.inherit.sales.journal</field>
        <field name="model">stock.warehouse</field>
        <field name="inherit_id" ref="stock.view_warehouse"/>
        <field name="arch" type="xml">

            <!-- بعد أول group في الفورم -->
            <xpath expr="//sheet/group" position="after">
                <group string="Accounting">
                    <field name="sales_journal_id"/>
                </group>
            </xpath>

        </field>
    </record>


    <!-- =====================================================
         Analytic Distribution Model - Tree View
    ====================================================== -->
    <record id="analytic_distribution_model_tree_add_journal_salesperson" model="ir.ui.view">
        <field name="name">analytic.distribution.model.tree.add.journal.salesperson</field>
        <field name="model">account.analytic.distribution.model</field>
        <field name="inherit_id"
               ref="analytic.account_analytic_distribution_model_tree_view"/>
        <field name="arch" type="xml">

            <!-- Sales Journal -->
            <xpath expr="//field[@name='analytic_distribution']" position="before">
                <field name="user_id" optional="show"/>

                <field name="sales_journal_id" optional="show"/>
            </xpath>

        </field>
    </record>


    <!-- =====================================================
         Analytic Distribution Model - Form View
    ====================================================== -->
    <record id="analytic_distribution_model_form_add_journal_salesperson" model="ir.ui.view">
        <field name="name">analytic.distribution.model.form.add.journal.salesperson</field>
        <field name="model">account.analytic.distribution.model</field>
        <field name="inherit_id"
               ref="analytic.account_analytic_distribution_model_form_view"/>
        <field name="arch" type="xml">

            <!-- بعد Partner / Product -->
            <xpath expr="//group" position="inside">
                <field name="sales_journal_id"/>
                <field name="user_id"/>
            </xpath>

        </field>
    </record>


    <record id="view_move_form_journal_not_required" model="ir.ui.view">
    <field name="name">account.move.form.journal.not.required</field>
    <field name="model">account.move</field>
    <field name="inherit_id" ref="account.view_move_form"/>
    <field name="arch" type="xml">

        <xpath expr="//field[@name='journal_id']" position="attributes">
            <attribute name="required">0</attribute>
        </xpath>

    </field>
</record>


</odoo>
